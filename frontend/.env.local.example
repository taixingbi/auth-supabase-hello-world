# Next.js BFF → gateway service
GATEWAY_URL=http://localhost:8000

# Same Supabase keys as gateway/.env (gateway uses these at runtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Must match gateway JWT_EXPIRY_SECONDS and Supabase JWT expiry (1 hour)
NEXT_PUBLIC_JWT_EXPIRY_SECONDS=3600
