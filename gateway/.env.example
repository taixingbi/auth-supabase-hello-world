# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Must match Supabase Dashboard → Authentication → JWT expiry (seconds)
JWT_EXPIRY_SECONDS=3600

# Server-only — Project Settings → API → service_role (NOT anon / publishable)
# Wrong key causes "User not allowed" on profile save; gateway falls back to user JWT.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret
