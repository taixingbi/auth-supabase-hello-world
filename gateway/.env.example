# Supabase (Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Must match Supabase Dashboard → Authentication → JWT expiry (seconds)
JWT_EXPIRY_SECONDS=3600

# Server-only — service_role secret (NOT anon / publishable)
# Wrong key causes "User not allowed" on profile save; gateway falls back to user JWT.
SUPABASE_SERVICE_KEY=your-service-role-secret
